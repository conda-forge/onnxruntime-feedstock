From 345546f4bd0fc49f5f544fa5c3b1bdf617d94b74 Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sat, 19 Sep 2026 09:35:27 -0400
Subject: [PATCH] Drop the stale MSVC /permissive workaround from the CUDA EP

onnxruntime_providers_cuda is compiled with MSVC's /permissive to work
around a CUTLASS cute/stride.hpp error (NVIDIA/cutlass#3065). The CUTLASS
sources live in the separate onnxruntime_providers_cuda_sm*_tma targets,
which set the flag for themselves, and the pinned CUTLASS v4.7.0 no longer
contains the reported code.

/permissive turns off two-phase name lookup, which abseil's headers need:
they name a base class through the derived class, e.g.

    friend class MixingHashState::HashStateBase;          # absl/hash
    using Base = typename flat_hash_map::raw_hash_map;    # absl/container

Through nvcc 13.4 the host compiler rejects those:

    absl/hash/internal/hash.h(1428): error C3856: 'HashStateBase': symbol
      is not a class template
    absl/container/flat_hash_map.h(141): error C2248: cannot access private
      typedef declared in class 'raw_hash_map'
---
 cmake/onnxruntime_providers_cuda.cmake | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/cmake/onnxruntime_providers_cuda.cmake b/cmake/onnxruntime_providers_cuda.cmake
index 52eb245..7ad1b73 100644
--- a/cmake/onnxruntime_providers_cuda.cmake
+++ b/cmake/onnxruntime_providers_cuda.cmake
@@ -213,16 +213,14 @@
     onnxruntime_add_shared_library_module(onnxruntime_providers_cuda ${onnxruntime_providers_cuda_all_srcs})
   endif()
 
-  if (MSVC)
-    # Use /permissive to work around compilation error from CUTLASS header cute/tensor.hpp:
-    #   cutlass-src\include\cute\stride.hpp(299,46): error C3545: 'Ints': parameter pack expects a non-type
-    #     template argument
-    # See https://github.com/NVIDIA/cutlass/issues/3065
-    target_compile_options(onnxruntime_providers_cuda PRIVATE
-      "$<$<COMPILE_LANGUAGE:CXX>:/permissive>"
-      "$<$<COMPILE_LANGUAGE:CUDA>:SHELL:-Xcompiler /permissive>"
-    )
-  endif()
+  # The CUTLASS sources that needed MSVC's /permissive (cute/stride.hpp, see
+  # https://github.com/NVIDIA/cutlass/issues/3065) are built in the separate
+  # onnxruntime_providers_cuda_sm*_tma targets, which set the flag themselves.
+  # This target does not include cute headers, and /permissive turns off
+  # two-phase name lookup, which abseil's headers need: they name a base class
+  # through the derived class, e.g. "friend class MixingHashState::HashStateBase;"
+  # and "using Base = typename flat_hash_map::raw_hash_map;". Through nvcc 13.4
+  # the host compiler then rejects them with C3856 / C2248.
 
   if(WIN32)
     # FILE_NAME preprocessor definition is used in onnxruntime_providers_cuda.rc
-- 
2.55.0


From 86a4af5774a1b343bcb6efb210728444b20612fb Mon Sep 17 00:00:00 2001
From: Mark Harfouche <mark.harfouche@gmail.com>
Date: Sat, 19 Sep 2026 10:04:09 -0400
Subject: [PATCH] Keep two-phase name lookup for the CUDA EP on MSVC

onnxruntime_providers_cuda is configured by
config_cuda_provider_shared_module(), which adds MSVC's /permissive for
the CUTLASS cute headers (NVIDIA/cutlass#3065). /permissive also turns off
two-phase name lookup, which abseil's headers need: they name a base class
through the derived class, e.g.

    friend class MixingHashState::HashStateBase;          # absl/hash
    using Base = typename flat_hash_map::raw_hash_map;    # absl/container

Through nvcc 13.4 the host compiler then rejects them:

    absl/hash/internal/hash.h(1428): error C3856: 'HashStateBase': symbol
      is not a class template
    absl/container/flat_hash_map.h(141): error C2248: cannot access private
      typedef declared in class 'raw_hash_map'

This target does not compile CUTLASS kernels; those are built in the
separate onnxruntime_providers_cuda_sm*_tma object libraries, which keep
/permissive. Re-enable two-phase lookup for this target only, after the
configuration call so that it wins on the command line.
---
 cmake/onnxruntime_providers_cuda.cmake | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/cmake/onnxruntime_providers_cuda.cmake b/cmake/onnxruntime_providers_cuda.cmake
index 52eb245..5be0bbb 100644
--- a/cmake/onnxruntime_providers_cuda.cmake
+++ b/cmake/onnxruntime_providers_cuda.cmake
@@ -492,6 +492,22 @@
   config_cuda_provider_shared_module(onnxruntime_providers_cuda)
   target_compile_options(onnxruntime_providers_cuda PRIVATE "$<$<COMPILE_LANGUAGE:CUDA>:SHELL:--threads \"${onnxruntime_NVCC_THREADS}\">")
 
+  if (MSVC)
+    # config_cuda_provider_shared_module() adds /permissive for the CUTLASS cute
+    # headers, which also turns off two-phase name lookup. abseil's headers need
+    # it: they name a base class through the derived class, e.g.
+    #   friend class MixingHashState::HashStateBase;        (absl/hash)
+    #   using Base = typename flat_hash_map::raw_hash_map;  (absl/container)
+    # and the host code nvcc 13.4 generates is then rejected with C3856 / C2248.
+    # This target does not compile CUTLASS kernels (they live in the separate
+    # onnxruntime_providers_cuda_sm*_tma targets), so restore the conformant
+    # lookup here. Listed after the call so it wins on the command line.
+    target_compile_options(onnxruntime_providers_cuda PRIVATE
+      "$<$<COMPILE_LANGUAGE:CXX>:/Zc:twoPhase>"
+      "$<$<COMPILE_LANGUAGE:CUDA>:SHELL:-Xcompiler /Zc:twoPhase>"
+    )
+  endif()
+
   # Create OBJECT libraries for SM-specific contrib CUDA sources that must be compiled
   # with restricted CUDA architectures. These files use CUTLASS 3.x SM90+/SM120+ features
   # (GMMA, TMA) that cannot produce useful device code for older architectures.
-- 

 REGISTER_VERSIONED_UNARY_ELEMENTWISE_TYPED_KERNEL(Tanh, 6, 12, double);
-REGISTER_UNARY_ELEMENTWISE_KERNEL(Celu, 12);
+REGISTER_VERSIONED_UNARY_ELEMENTWISE_KERNEL(Celu, 12, 28);

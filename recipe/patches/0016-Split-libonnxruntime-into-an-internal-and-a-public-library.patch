+cmake_dependent_option(onnxruntime_BUILD_INTERNAL_SHARED_LIB "Build the implementation as libonnxruntime_internal, which exports the internal symbols for the Python bindings, and libonnxruntime as a library that forwards the public API to it (Linux, macOS, and Windows with the Python bindings)" OFF "onnxruntime_BUILD_SHARED_LIB;CMAKE_SYSTEM_NAME STREQUAL Linux OR CMAKE_SYSTEM_NAME STREQUAL Darwin OR (MSVC AND onnxruntime_ENABLE_PYTHON)" OFF)

+#!/usr/bin/env python3
+# Copyright (c) Microsoft Corporation. All rights reserved.
+# Licensed under the MIT License.
+
+"""Writes the module-definition file of onnxruntime_internal.dll.
+
+It exports the public API and every symbol that the given objects (the Python bindings) take from the given static
+libraries. Data must be imported with __declspec(dllimport), so a data symbol that the objects reference directly is
+an error. The output is only rewritten when it changes, so that the DLL is not relinked when the objects are rebuilt.
+"""
+
+import argparse
+import os
+import re
+import subprocess
+import sys
+
+SYMBOL_RE = re.compile(r"^[0-9A-F]{3,} [0-9A-F]{8} (SECT[0-9A-F]+|UNDEF)\s+\w+\s*(\(\))?\s+External\s+\| (\S+)")
+
+
+def parse_arguments():
+    parser = argparse.ArgumentParser(fromfile_prefix_chars="@")
+    parser.convert_arg_line_to_args = lambda line: [line.strip()] if line.strip() else []
+    parser.add_argument("--dumpbin", required=True)
+    parser.add_argument("--public_def", required=True, help="module-definition file of the public API")
+    parser.add_argument("--output", required=True)
+    parser.add_argument("--objects", nargs="*", default=[])
+    parser.add_argument("--libraries", nargs="*", default=[], help="static libraries to export symbols from")
+    parser.add_argument("--excluded_libraries", nargs="*", default=[], help="static libraries not to export symbols from")
+    return parser.parse_args()
+
+
+def external_symbols(dumpbin, paths):
+    """Yields (name, defined, is_function) for the external symbols of object files or static libraries."""
+    for i in range(0, len(paths), 64):
+        out = subprocess.run(
+            [dumpbin, "/nologo", "/SYMBOLS", *paths[i : i + 64]],
+            capture_output=True,
+            text=True,
+            errors="replace",
+            check=True,
+        )
+        for line in out.stdout.splitlines():
+            m = SYMBOL_RE.match(line)
+            if m:
+                section, function, name = m.groups()
+                yield name, section != "UNDEF", function is not None
+
+
+args = parse_arguments()
+
+public = []
+with open(args.public_def) as file:
+    for line in file:
+        fields = line.split()
+        if len(fields) == 2 and fields[1].startswith("@"):
+            public.append(fields[0])
+
+defined = {}
+for name, is_defined, is_function in external_symbols(args.dumpbin, args.libraries):
+    if is_defined:
+        defined.setdefault(name, is_function)
+for name, is_defined, _ in external_symbols(args.dumpbin, args.excluded_libraries):
+    if is_defined:
+        defined.pop(name, None)
+
+referenced = set()
+imported = set()
+defined_in_objects = set()
+for name, is_defined, _ in external_symbols(args.dumpbin, args.objects):
+    if is_defined:
+        defined_in_objects.add(name)
+    elif name.startswith("__imp_"):
+        imported.add(name[len("__imp_") :])
+    else:
+        referenced.add(name)
+
+functions = []
+data = []
+errors = []
+for name in sorted((referenced | imported) - defined_in_objects - set(public)):
+    if name not in defined:
+        continue
+    if defined[name]:
+        functions.append(name)
+    elif name in imported:
+        data.append(name)
+    else:
+        errors.append(name)
+if errors:
+    sys.exit(
+        "These data symbols must be declared __declspec(dllimport) in the objects:\n"
+        + "\n".join(errors)
+    )
+
+lines = ["LIBRARY", "EXPORTS"]
+lines += [f" {name}" for name in public + functions]
+lines += [f" {name} DATA" for name in data]
+content = "\n".join(lines) + "\n"
+if not os.path.exists(args.output) or open(args.output).read() != content:
+    with open(args.output, "w") as file:
+        file.write(content)

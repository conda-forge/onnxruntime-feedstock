From: conda-forge onnxruntime-feedstock
Subject: [PATCH] Optionally split libonnxruntime into an internal and a public library

The Python bindings link the static libraries, so they contain a second copy
of everything in libonnxruntime, with its own global state.

The new option onnxruntime_BUILD_INTERNAL_SHARED_LIB (Linux and macOS) builds the
implementation as libonnxruntime_internal.so.<version>, which exports every
symbol under ORT_INTERNAL_<version> except the public API and the vendored
cpuinfo symbols. libonnxruntime.so.1 keeps exporting only the public API in
VERS_<version>: each public function is a GNU indirect function that
resolves to the implementation through GetFunctionEntryByName. The Python
bindings link libonnxruntime_internal ahead of the static libraries, so the
linker takes only what libonnxruntime_internal lacks from them.

On macOS, libonnxruntime_internal.<version>.dylib is built with default
visibility and exports everything but the vendored cpuinfo symbols, and
libonnxruntime.1.dylib re-exports only the public API from it with
-reexported_symbols_list.
---
diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
index 3a3bda1..b5334fe 100644
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -147,6 +147,7 @@ option(onnxruntime_USE_AVX2 "Use AVX2 instructions" OFF)
 option(onnxruntime_USE_AVX512 "Use AVX512 instructions" OFF)
 
 option(onnxruntime_BUILD_SHARED_LIB "Build a shared library" OFF)
+cmake_dependent_option(onnxruntime_BUILD_INTERNAL_SHARED_LIB "Build the implementation as libonnxruntime_internal, which exports the internal symbols for the Python bindings, and libonnxruntime as a library that forwards the public API to it (Linux and macOS only)" OFF "onnxruntime_BUILD_SHARED_LIB;CMAKE_SYSTEM_NAME STREQUAL Linux OR CMAKE_SYSTEM_NAME STREQUAL Darwin" OFF)
 option(onnxruntime_BUILD_APPLE_FRAMEWORK "Build a macOS/iOS framework" OFF)
 option(onnxruntime_ENABLE_MICROSOFT_INTERNAL "Use this option to enable/disable microsoft internal only code" OFF)
 
diff --git a/cmake/adjust_global_compile_flags.cmake b/cmake/adjust_global_compile_flags.cmake
index 6e548ac..5f71fd8 100644
--- a/cmake/adjust_global_compile_flags.cmake
+++ b/cmake/adjust_global_compile_flags.cmake
@@ -206,7 +206,8 @@ endif()
 
 # Mark symbols to be invisible, for macOS/iOS/visionOS/tvOS target only
 # Due to many dependencies have different symbol visibility settings, set global compile flags here.
-if (${CMAKE_SYSTEM_NAME} MATCHES "Darwin|iOS|visionOS|tvOS")
+# libonnxruntime_internal exports the internal symbols, so they must stay visible.
+if (${CMAKE_SYSTEM_NAME} MATCHES "Darwin|iOS|visionOS|tvOS" AND NOT onnxruntime_BUILD_INTERNAL_SHARED_LIB)
   foreach(flags CMAKE_CXX_FLAGS CMAKE_OBJC_FLAGS CMAKE_OBJCXX_FLAGS)
     string(APPEND ${flags} " -fvisibility=hidden -fvisibility-inlines-hidden")
   endforeach()
diff --git a/cmake/onnxruntime.cmake b/cmake/onnxruntime.cmake
index a977141..9e36e8a 100644
--- a/cmake/onnxruntime.cmake
+++ b/cmake/onnxruntime.cmake
@@ -78,17 +78,26 @@ if(onnxruntime_BUILD_SHARED_LIB)
     list(APPEND SYMBOL_FILES "${ANDROID_TELEMETRY_SYMBOL_FILE}")
     set(ANDROID_TELEMETRY_SYMBOL_ARGS --extra_symbol_file "${ANDROID_TELEMETRY_SYMBOL_FILE}")
   endif()
+  if(onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+    if(APPLE)
+      set(INTERNAL_SYMBOL_FILE ${CMAKE_CURRENT_BINARY_DIR}/onnxruntime_internal_unexported.txt)
+    else()
+      set(INTERNAL_SYMBOL_FILE ${CMAKE_CURRENT_BINARY_DIR}/onnxruntime_internal.lds)
+    endif()
+    set(FORWARDERS_SOURCE ${CMAKE_CURRENT_BINARY_DIR}/onnxruntime_forwarders.c)
+    set(INTERNAL_SHARED_LIB_ARGS --output_internal ${INTERNAL_SYMBOL_FILE} --output_forwarders ${FORWARDERS_SOURCE})
+  endif()
 
-  add_custom_command(OUTPUT ${SYMBOL_FILE} ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c
+  add_custom_command(OUTPUT ${SYMBOL_FILE} ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c ${INTERNAL_SYMBOL_FILE} ${FORWARDERS_SOURCE}
     COMMAND ${Python_EXECUTABLE} "${REPO_ROOT}/tools/ci_build/gen_def.py"
       --version_file "${ONNXRUNTIME_ROOT}/../VERSION_NUMBER" --src_root "${ONNXRUNTIME_ROOT}"
-      --config ${ONNXRUNTIME_PROVIDER_NAMES} ${ANDROID_TELEMETRY_SYMBOL_ARGS}
+      --config ${ONNXRUNTIME_PROVIDER_NAMES} ${ANDROID_TELEMETRY_SYMBOL_ARGS} ${INTERNAL_SHARED_LIB_ARGS}
       --style=${OUTPUT_STYLE} --output ${SYMBOL_FILE}
       --output_source ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c
     DEPENDS ${SYMBOL_FILES}
     WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR})
 
-  add_custom_target(onnxruntime_generate_def ALL DEPENDS ${SYMBOL_FILE} ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c)
+  add_custom_target(onnxruntime_generate_def ALL DEPENDS ${SYMBOL_FILE} ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c ${INTERNAL_SYMBOL_FILE} ${FORWARDERS_SOURCE})
   if(WIN32)
     onnxruntime_add_shared_library(onnxruntime
       ${SYMBOL_FILE}
@@ -144,6 +153,40 @@ if(onnxruntime_BUILD_SHARED_LIB)
       MACOSX_FRAMEWORK_INFO_PLIST ${INFO_PLIST_PATH}
       # Note: The PUBLIC_HEADER and VERSION properties for the 'onnxruntime' target will be set later in this file.
     )
+  elseif(onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+    # libonnxruntime_internal holds the implementation and exports the internal symbols;
+    # libonnxruntime only forwards (Linux) or re-exports (macOS) the public symbols.
+    onnxruntime_add_shared_library(onnxruntime_internal ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c)
+    add_dependencies(onnxruntime_internal onnxruntime_generate_def ${onnxruntime_EXTERNAL_DEPENDENCIES})
+    target_include_directories(onnxruntime_internal PRIVATE ${ONNXRUNTIME_ROOT})
+    if(APPLE)
+      target_link_options(onnxruntime_internal PRIVATE "LINKER:-unexported_symbols_list,${INTERNAL_SYMBOL_FILE}" "LINKER:-dead_strip")
+      set_target_properties(onnxruntime_internal PROPERTIES
+        MACOSX_RPATH TRUE
+        BUILD_WITH_INSTALL_RPATH TRUE
+        INSTALL_RPATH "@loader_path"
+        BUILD_WITH_INSTALL_NAME_DIR TRUE
+        INSTALL_NAME_DIR @rpath)
+    else()
+      target_link_options(onnxruntime_internal PRIVATE "LINKER:-rpath=\$ORIGIN"
+        "LINKER:--version-script=${INTERNAL_SYMBOL_FILE}" "LINKER:--no-undefined" "LINKER:--gc-sections" "LINKER:-z,noexecstack")
+    endif()
+    set_target_properties(onnxruntime_internal PROPERTIES
+      LINK_DEPENDS ${INTERNAL_SYMBOL_FILE}
+      VERSION ${ORT_VERSION}
+      SOVERSION ${ORT_VERSION}
+      FOLDER "ONNXRuntime")
+    install(TARGETS onnxruntime_internal
+            EXPORT ${PROJECT_NAME}Targets
+            LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR})
+
+    onnxruntime_add_shared_library(onnxruntime ${FORWARDERS_SOURCE})
+    target_link_libraries(onnxruntime PRIVATE onnxruntime_internal)
+    if(APPLE)
+      target_link_options(onnxruntime PRIVATE "LINKER:-reexported_symbols_list,${SYMBOL_FILE}")
+    else()
+      target_link_options(onnxruntime PRIVATE "LINKER:-rpath=\$ORIGIN")
+    endif()
   else()
     onnxruntime_add_shared_library(onnxruntime ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c)
     if(NOT APPLE)
@@ -182,7 +225,9 @@ if(onnxruntime_BUILD_SHARED_LIB)
 
 
   if (APPLE)
-    target_link_options(onnxruntime PRIVATE  "LINKER:-exported_symbols_list,${SYMBOL_FILE}")
+    if (NOT onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+      target_link_options(onnxruntime PRIVATE  "LINKER:-exported_symbols_list,${SYMBOL_FILE}")
+    endif()
     set_target_properties(onnxruntime PROPERTIES
       MACOSX_RPATH TRUE
       BUILD_WITH_INSTALL_RPATH TRUE
@@ -298,7 +343,12 @@ endif()
 
 # If you are linking a new library, please add it to the list onnxruntime_INTERNAL_LIBRARIES or onnxruntime_EXTERNAL_LIBRARIES,
 # Please do not add a library directly to the target_link_libraries command
-if (onnxruntime_BUILD_SHARED_LIB)
+if (onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+  target_link_libraries(onnxruntime_internal PRIVATE
+      ${onnxruntime_INTERNAL_LIBRARIES}
+      ${onnxruntime_EXTERNAL_LIBRARIES}
+  )
+elseif (onnxruntime_BUILD_SHARED_LIB)
   target_link_libraries(onnxruntime PRIVATE
       ${onnxruntime_INTERNAL_LIBRARIES}
       ${onnxruntime_EXTERNAL_LIBRARIES}
diff --git a/cmake/onnxruntime_python.cmake b/cmake/onnxruntime_python.cmake
index 2c8ff75..5f72d40 100644
--- a/cmake/onnxruntime_python.cmake
+++ b/cmake/onnxruntime_python.cmake
@@ -220,6 +220,11 @@ if(WIN32)
   # onnxruntime_pybind11_state is a DLL
   target_sources(onnxruntime_pybind11_state PRIVATE "${ONNXRUNTIME_ROOT}/core/dll/dllmain.cc")
 endif()
+# libonnxruntime_internal exports the internal symbols, so listing it first resolves
+# them there instead of in the static libraries.
+if(onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+  target_link_libraries(onnxruntime_pybind11_state PRIVATE onnxruntime_internal)
+endif()
 target_link_libraries(onnxruntime_pybind11_state PRIVATE
     onnxruntime_session
     ${onnxruntime_libs}
@@ -854,10 +859,14 @@ add_custom_command(
 )
 
 if (onnxruntime_BUILD_SHARED_LIB)
+  set(onnxruntime_python_shared_libs $<TARGET_FILE:onnxruntime>)
+  if (onnxruntime_BUILD_INTERNAL_SHARED_LIB)
+    list(APPEND onnxruntime_python_shared_libs $<TARGET_FILE:onnxruntime_internal>)
+  endif()
   add_custom_command(
     TARGET onnxruntime_pybind11_state POST_BUILD
     COMMAND ${CMAKE_COMMAND} -E copy
-        $<TARGET_FILE:onnxruntime>
+        ${onnxruntime_python_shared_libs}
         $<TARGET_FILE_DIR:${build_output_target}>/onnxruntime/capi/
   )
 endif()
diff --git a/tools/ci_build/gen_def.py b/tools/ci_build/gen_def.py
index 15965a1..c6051fc 100755
--- a/tools/ci_build/gen_def.py
+++ b/tools/ci_build/gen_def.py
@@ -18,6 +18,14 @@ def parse_arguments():
         default=[],
         help="Additional symbols to export without adding them to GetFunctionEntryByName",
     )
+    parser.add_argument(
+        "--output_internal",
+        help="gcc: version script for a library that exports everything but the public symbols; xcode: its unexported symbols list",
+    )
+    parser.add_argument(
+        "--output_forwarders",
+        help="gcc: C source that forwards the public symbols to GetFunctionEntryByName; xcode: an empty C source",
+    )
     return parser.parse_args()
 
 
@@ -80,6 +88,32 @@ with open(args.output, "w") as file:
         file.write("    *;\n")
         file.write("};   \n")
 
+if args.output_internal and args.style == "xcode":
+    with open(args.output_internal, "w") as file:
+        file.write("_cpuinfo_*\n")
+elif args.output_internal:
+    with open(args.output_internal, "w") as file:
+        file.write(f"ORT_INTERNAL_{VERSION_STRING} {{\n")
+        file.write(" global:\n")
+        file.write("  *;\n")
+        file.write(" local:\n")
+        file.write("  cpuinfo_*;\n")
+        for symbol in symbols:
+            file.write(f"  {symbol};\n")
+        file.write("};\n")
+
+if args.output_forwarders and args.style == "xcode":
+    with open(args.output_forwarders, "w") as file:
+        file.write("typedef int onnxruntime_reexports_libonnxruntime_internal;\n")
+elif args.output_forwarders:
+    with open(args.output_forwarders, "w") as file:
+        file.write("void* GetFunctionEntryByName(const char* name);\n")
+        for symbol in symbols:
+            if symbol == "OrtGetWinMLAdapter":
+                continue
+            file.write(f'static void* resolve_{symbol}(void) {{ return GetFunctionEntryByName("{symbol}"); }}\n')
+            file.write(f'void {symbol}(void) __attribute__((ifunc("resolve_{symbol}")));\n')
+
 with open(args.output_source, "w") as file:
     file.write("#include <onnxruntime_c_api.h>\n")
     for c in args.config:

From: conda-forge onnxruntime-feedstock
Subject: [PATCH] Optionally link the Python bindings to the shared library

The Python bindings link the static libraries, so they contain a second copy
of everything in libonnxruntime (about 30 MB on linux-64). The new option
onnxruntime_PYBIND_LINK_SHARED_LIB (Linux only) exports the internal symbols
of libonnxruntime under a separate ORT_INTERNAL_<version> node, keeping the
public API in VERS_<version> and the vendored cpuinfo symbols hidden, and
links the bindings to libonnxruntime ahead of the static libraries. The
linker then takes only what libonnxruntime lacks from the static libraries.
---
diff --git a/cmake/CMakeLists.txt b/cmake/CMakeLists.txt
index 3a3bda1..0aa3e9e 100644
--- a/cmake/CMakeLists.txt
+++ b/cmake/CMakeLists.txt
@@ -147,6 +147,7 @@ option(onnxruntime_USE_AVX2 "Use AVX2 instructions" OFF)
 option(onnxruntime_USE_AVX512 "Use AVX512 instructions" OFF)
 
 option(onnxruntime_BUILD_SHARED_LIB "Build a shared library" OFF)
+cmake_dependent_option(onnxruntime_PYBIND_LINK_SHARED_LIB "Link the Python bindings to the shared library instead of the static libraries (Linux only)" OFF "onnxruntime_BUILD_SHARED_LIB;CMAKE_SYSTEM_NAME STREQUAL Linux" OFF)
 option(onnxruntime_BUILD_APPLE_FRAMEWORK "Build a macOS/iOS framework" OFF)
 option(onnxruntime_ENABLE_MICROSOFT_INTERNAL "Use this option to enable/disable microsoft internal only code" OFF)
 
diff --git a/cmake/onnxruntime.cmake b/cmake/onnxruntime.cmake
index a977141..852b23d 100644
--- a/cmake/onnxruntime.cmake
+++ b/cmake/onnxruntime.cmake
@@ -78,11 +78,14 @@ if(onnxruntime_BUILD_SHARED_LIB)
     list(APPEND SYMBOL_FILES "${ANDROID_TELEMETRY_SYMBOL_FILE}")
     set(ANDROID_TELEMETRY_SYMBOL_ARGS --extra_symbol_file "${ANDROID_TELEMETRY_SYMBOL_FILE}")
   endif()
+  if(onnxruntime_PYBIND_LINK_SHARED_LIB)
+    set(EXPORT_INTERNAL_SYMBOLS_ARG --export_internal_symbols)
+  endif()
 
   add_custom_command(OUTPUT ${SYMBOL_FILE} ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c
     COMMAND ${Python_EXECUTABLE} "${REPO_ROOT}/tools/ci_build/gen_def.py"
       --version_file "${ONNXRUNTIME_ROOT}/../VERSION_NUMBER" --src_root "${ONNXRUNTIME_ROOT}"
-      --config ${ONNXRUNTIME_PROVIDER_NAMES} ${ANDROID_TELEMETRY_SYMBOL_ARGS}
+      --config ${ONNXRUNTIME_PROVIDER_NAMES} ${ANDROID_TELEMETRY_SYMBOL_ARGS} ${EXPORT_INTERNAL_SYMBOLS_ARG}
       --style=${OUTPUT_STYLE} --output ${SYMBOL_FILE}
       --output_source ${CMAKE_CURRENT_BINARY_DIR}/generated_source.c
     DEPENDS ${SYMBOL_FILES}
diff --git a/cmake/onnxruntime_python.cmake b/cmake/onnxruntime_python.cmake
index 2c8ff75..89da8d5 100644
--- a/cmake/onnxruntime_python.cmake
+++ b/cmake/onnxruntime_python.cmake
@@ -220,6 +220,11 @@ if(WIN32)
   # onnxruntime_pybind11_state is a DLL
   target_sources(onnxruntime_pybind11_state PRIVATE "${ONNXRUNTIME_ROOT}/core/dll/dllmain.cc")
 endif()
+# With onnxruntime_PYBIND_LINK_SHARED_LIB, the shared library exports the internal
+# symbols, so listing it first resolves them there instead of in the static libraries.
+if(onnxruntime_PYBIND_LINK_SHARED_LIB)
+  target_link_libraries(onnxruntime_pybind11_state PRIVATE onnxruntime)
+endif()
 target_link_libraries(onnxruntime_pybind11_state PRIVATE
     onnxruntime_session
     ${onnxruntime_libs}
diff --git a/tools/ci_build/gen_def.py b/tools/ci_build/gen_def.py
index 15965a1..34a09bf 100755
--- a/tools/ci_build/gen_def.py
+++ b/tools/ci_build/gen_def.py
@@ -18,6 +18,11 @@ def parse_arguments():
         default=[],
         help="Additional symbols to export without adding them to GetFunctionEntryByName",
     )
+    parser.add_argument(
+        "--export_internal_symbols",
+        action="store_true",
+        help="gcc style only: also export all other symbols under a separate ORT_INTERNAL version node",
+    )
     return parser.parse_args()
 
 
@@ -75,7 +80,15 @@ with open(args.output, "w") as file:
             file.write(f"  {symbol};\n")
         symbol_index += 1
 
-    if args.style == "gcc":
+    if args.style == "gcc" and args.export_internal_symbols:
+        file.write("};\n")
+        file.write(f"ORT_INTERNAL_{VERSION_STRING} {{\n")
+        file.write(" global:\n")
+        file.write("  *;\n")
+        file.write(" local:\n")
+        file.write("  cpuinfo_*;\n")
+        file.write("};\n")
+    elif args.style == "gcc":
         file.write(" local:\n")
         file.write("    *;\n")
         file.write("};   \n")
